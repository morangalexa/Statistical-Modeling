```{r}
set.seed(123)

# PARAMETERS
n_pairs <- 19
n_people <- n_pairs * 2
n_dates <- 3
n_sims <- 1000

simulate_once <- function() {
  
  # Step 1: assign 3 unique dates per person (no self, no pair partner)
  dates_list <- vector("list", n_people)
  
  for (i in 1:n_people) {
    pair_partner <- ifelse(i %% 2 == 1, i + 1, i - 1)
    possible <- setdiff(1:n_people, c(i, pair_partner))
    dates_list[[i]] <- sample(possible, n_dates)
  }
  
  # Step 2: each person chooses exactly 1 of their 3 dates
  choices <- sapply(dates_list, function(x) sample(x, 1))
  
  # Step 3: count how many votes each person receives
  received_votes <- tabulate(choices, nbins = n_people)
  
  # Step 4: compute pair multiplication scores
  pairs <- matrix(received_votes, ncol = 2, byrow = TRUE)
  pair_scores <- pairs[,1] * pairs[,2]
  
  return(pair_scores)
}

# RUN SIMULATIONS
all_results <- replicate(n_sims, simulate_once())
all_scores <- as.vector(all_results)
```

```{r}
# DISTRIBUTION
score_dist <- prop.table(table(all_scores))
print(score_dist)
```

```{r}
# PLOT
barplot(score_dist,
        main = "Pair Multiplication Score Distribution (1-choice model)",
        xlab = "M = kA * kB",
        ylab = "Probability",
        col = "steelblue")
```

```{r}
# Application
# I have 19 pairs to begin with, how many pairs have score zero?
p_zero <- score_dist["0"]
elim_pairs <- p_zero * n_pairs
elim_pairs
```
